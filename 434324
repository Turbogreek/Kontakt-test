<!DOCTYPE html>
<html>
<head>
<style>
.center {
 
    display: flex;
    justify-content: center;
    align-items: center;
    height: 1vh;
    text-align: center;
}
.split-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.left, .right {
  padding: 20px;
}
.static {
  display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 1vh;
}
body {
  background-color: rgb(240, 240, 240);
}

h1 {
  color: rgb(5, 0, 0);
  text-align: center;
}

p {
  font-family: Open Sans, sans-serif;
  font-size: 20px;
}
</style>
</head>
<body>

<h1>Oliver Trakossas</h1>
<div class="static">
<p> ____________________________________</p>
</div>

<div class="center, split-container">
  <div class="left,center">
    <h2>Udannelse</h2>
    <p>TEC Data og kommunikation, 2025 </p>
  </div>
  <div class="right">
    <h2>Erfaring</h2>
    <p></p>
  </div>
</div>

</body>
</html>

